# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017

# External Factor Service Configuration
# These are optional - if not provided, external stress score will not be fetched from APIs

# Weather API (OpenWeatherMap)
# Get free API key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Air Quality Index API (WAQI)
# Get free API key at: https://waqi.info/api
AQI_API_KEY=your_waqi_api_key
AQI_API_URL=https://api.waqi.info

# News API (for emergency alerts)
# Get free API key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key
NEWS_API_URL=https://newsapi.org/v2

# Disaster Alerts API (GDACS)
# Free, no API key required for basic usage
DISASTER_API_KEY=your_gdacs_key
DISASTER_API_URL=https://api.gdacs.org
